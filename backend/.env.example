# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/youtube-shorts?retryWrites=true&w=majority

# ─── Google OAuth (https://console.cloud.google.com/) ────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-app.koyeb.app/api/auth/callback

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://your-app.koyeb.app
